{
   "compilerOptions": {
      "ignoreDeprecations": "5.0",
      "rootDir": "./",
      "outDir": "./dist",
      "module": "CommonJS",
      "target": "ES2020",
      "types": ["node"],
      "lib": ["ES2020"],
      "moduleResolution": "bundler",
      "strict": true, 
      "esModuleInterop": true,
      "allowJs": true,
      "isolatedModules": true,
      "skipLibCheck": true,
      "sourceMap": true, 
      "resolveJsonModule": true, 
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "./dist"]
}
